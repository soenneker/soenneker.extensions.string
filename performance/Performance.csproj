<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>
  <Import Project="Audit.Projects.props" Condition="Exists('Audit.Projects.props')" />
  <Target Name="RequireAuditPreparation" BeforeTargets="PrepareForBuild" Condition="!Exists('Audit.Projects.props')">
    <Error Text="Run python prepare.py and python prepare-builder.py from performance/ to locate the existing checkouts and generate comparison sources." />
  </Target>
</Project>
